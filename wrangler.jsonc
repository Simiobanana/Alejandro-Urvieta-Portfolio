{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alejandro-urvieta-portfolio",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "alejandrourvieta.com", "custom_domain": true },
    { "pattern": "www.alejandrourvieta.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alejandro-urvieta-portfolio",
      "database_id": "3d22c8a5-11d8-4bfa-be4d-5e9ef21d5f5f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "alejandro-urvieta-portfolio-media"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "alejandroug2608@gmail.com",
    "ACCESS_ENABLED": "true"
  },
  "observability": { "enabled": true }
}
